{
  "name": "agentic-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
    "build": "vite build && node scripts/offline/app-files.ts && node scripts/run-code/engine-files.ts",
    "start": "node --env-file-if-exists=.env scripts/serve.ts",
    "test": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.ts --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "e2e": "playwright test",
    "e2e:local": "playwright test --project=desktop --project=phone --project=tablet-landscape",
    "coverage:changed": "node scripts/coverage/changed-lines.ts coverage/unit/lcov.info origin/main..HEAD unit && node scripts/coverage/changed-lines.ts coverage/server/lcov.info origin/main..HEAD server",
    "coverage:ratchet": "node scripts/coverage/ratchet.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "ci:watch": "node scripts/ci/watch.ts",
    "smoke:dev": "node scripts/smoke-dev.ts",
    "voices:fetch": "node --env-file-if-exists=.env scripts/voices/fetch.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/db/migrate.ts",
    "db:users": "node --env-file-if-exists=.env scripts/db/users.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@base-ui/react": "^1.9.0",
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@mozilla/readability": "0.6.0",
    "@paddle/paddle-js": "1.6.6",
    "@resvg/resvg-js": "^2.6.2",
    "@simplewebauthn/server": "14.0.3",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "gemoji": "8.1.0",
    "github-slugger": "2.0.0",
    "lucide-react": "^1.66.0",
    "marked": "^18.1.3",
    "motion": "^14.9.0",
    "music-metadata": "12.3.5",
    "node-html-parser": "^9.0.6",
    "onnxruntime-web": "1.31.1",
    "postgres": "^4.0.0",
    "pyodide": "314.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "4.6.0",
    "srvx": "^1.0.8",
    "sucrase": "3.35.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-math": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.1.0",
    "pdfjs-dist": "6.5.438",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  }
}
