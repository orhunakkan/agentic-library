# Every setting Folio's server reads. Copy this file to .env for local development: the uncommented lines are
# local values that work with compose.yaml. Commented lines are optional, shown with their default. Where
# agenticlibrary.app uses another value, the comment says so. The server refuses to start, naming the setting, on a
# bad value. tests/repo/env-example.test.ts fails if a setting is added to the code without a line here.

# Server
# "production" in production. It makes DATABASE_URL, KEK and APP_ORIGIN required. Default: unset (development).
# NODE_ENV=production
# The address pnpm start listens on. Put a reverse proxy that terminates TLS in front of it.
# HOST=127.0.0.1
# The port pnpm start listens on, and the port in the default APP_ORIGIN. The dev server always uses 3000.
# PORT=3000
# The site's own origin, for links in mail and same-origin checks. Required in production.
# agenticlibrary.app: https://agenticlibrary.app
APP_ORIGIN=http://localhost:3000
# Whether the sign-in cookie needs HTTPS. Default: true. Locally the site is plain http.
COOKIE_SECURE=false

# Database
# Local Postgres from compose.yaml. In production, your own server, with a password that isn't "postgres".
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/agentic_dev
# Role that owns the tables, if migrations connect as a different role. Default: the connecting role.
# DB_OWNER_ROLE=

# Encryption
# Encrypts readers' saved API keys. Required in production; without it Folio runs, but no key can be saved.
# Generate with: openssl rand -base64 32 (any 32 random bytes, in base64).
# In production you can use the systemd credential "kek" instead: systemd's LoadCredential= puts it in the directory
# it names in CREDENTIALS_DIRECTORY, which Folio reads, and the key stays out of the environment.
KEK=
# The key before a rotation, so keys saved with it can still be read. Systemd credential: "kek_previous".
KEK_PREVIOUS=

# Sign-up and mail
# off, invite or open. Default: invite. open needs mail and, in production, SITE_CONTACT.
SIGNUP=invite
# resend sends mail through Resend. capture writes it to .mail/ instead, and only runs on localhost. Default: no mail.
# agenticlibrary.app: resend
MAIL_TRANSPORT=capture
# The From line, as an address or Name <address>. Required whenever MAIL_TRANSPORT is set.
MAIL_FROM=Folio <folio@example.com>
# Resend's API key, for MAIL_TRANSPORT=resend. Systemd credential: "resend_api_key".
RESEND_API_KEY=
# The signing secret of the Resend webhook that reports bounces (whsec_…). Systemd credential: "resend_webhook_secret".
RESEND_WEBHOOK_SECRET=

# Site
# Where readers send privacy questions and copyright notices: an email address or an https:// page. Shown on Privacy,
# Terms and Copyright. Required in production when SIGNUP=open. agenticlibrary.app: its own contact address.
# SITE_CONTACT=
# The public repository of the code this site runs, linked from the footers as "Source code". Default: no link.
# Set it for pnpm build too, and /third-party-licenses.txt names it.
# agenticlibrary.app: https://github.com/orhunakkan/agentic-library
# SOURCE_URL=

# Limits (see README, Limits). Defaults shown. Sizes are binary (1GB is 1024³ bytes) and need a unit.
# Audiobook storage per user, all audiobooks combined. agenticlibrary.app: 1GB
# LIMIT_USER_AUDIO=8GB
# The size of one audiobook. agenticlibrary.app: 1GB
# LIMIT_AUDIOBOOK_SIZE=2GB
# Picture storage per user, books and articles combined. agenticlibrary.app: 100MB
# LIMIT_USER_PICTURES=250MB
# Books per user, audiobooks included. agenticlibrary.app: the default
# LIMIT_BOOKS=25
# Saved articles per user. agenticlibrary.app: the default
# LIMIT_ARTICLES=500
# The stored text of one article, at most 8MB. agenticlibrary.app: the default
# LIMIT_ARTICLE_TEXT=1MB

# Storage
# Where pnpm voices:fetch puts the Folio voice's files, and where the server serves them from.
# VOICES_DIR=.cache/voices
# An absolute path for uploaded audiobooks, kept on disk outside the database. Default: unset, which turns
# audiobook uploads off.
# AUDIOBOOKS_DIR=
# The built-in catalogue's folders, separated like PATH. Default: content
# CONTENT_DIR=content

# Outside services
# A contact (an email address or URL) added to the User-Agent of book-detail lookups. With it, Open Library allows
# faster requests. Default: none.
# OPEN_LIBRARY_CONTACT=
# The same, for word and Wikipedia lookups, as Wikimedia's policy asks. Default: none.
# WIKIMEDIA_CONTACT=
# A fine-grained token (github_pat_…) with read-only access to public repositories, which raises GitHub's rate limit
# for the GitHub repositories feature. Systemd credential: "github_token". Default: none.
GITHUB_TOKEN=

# Only for tests. Operators don't need these: they point outside services at the local stubs in tests/stubs/.
# ANTHROPIC_API_BASE=https://api.anthropic.com
# OPENAI_API_BASE=https://api.openai.com
# ELEVENLABS_API_BASE=https://api.elevenlabs.io
# RESEND_API_BASE=https://api.resend.com
# OPEN_LIBRARY_BASE=https://openlibrary.org
# OPEN_LIBRARY_COVERS_BASE=https://covers.openlibrary.org
# WIKTIONARY_BASE=https://en.wiktionary.org
# WIKIPEDIA_BASE=https://{lang}.wikipedia.org
# GITHUB_API_BASE=https://api.github.com
# GITHUB_RAW_BASE=https://raw.githubusercontent.com
# host:port pairs that saved articles may be fetched from, on localhost only.
# ARTICLE_TEST_HOSTS=
# A base URL that the built-in catalogue's audio URLs are moved to.
# AUDIO_BASE=
# Where MAIL_TRANSPORT=capture writes mail. Default: .mail
# MAIL_CAPTURE_DIR=.mail
