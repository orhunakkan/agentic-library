#!/bin/sh
set -e

# The secrets scan of what's staged: gitleaks on PATH, or else the pinned image below. With neither, it says it skipped
# and carries on, so a contributor without Docker can still commit. There's no CI, so this is the only scan of a change.
# The staged diff goes to gitleaks on stdin, so it works the same in a linked worktree, whose .git is elsewhere.
GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f # v8.30.1
repo=$(git rev-parse --show-toplevel)
if command -v gitleaks >/dev/null 2>&1; then
  git diff --cached -U0 --no-color | gitleaks stdin --redact --no-banner --config "$repo/.gitleaks.toml"
elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  git diff --cached -U0 --no-color |
    docker run -i --rm -v "$repo/.gitleaks.toml:/config.toml:ro" "$GITLEAKS_IMAGE" \
      stdin --redact --no-banner --config /config.toml
else
  echo "pre-commit: secrets scan skipped (no gitleaks on PATH and no Docker); nothing else scans this commit" >&2
fi

pnpm exec biome check --staged --no-errors-on-unmatched
pnpm typecheck
pnpm exec vitest run tests/ --coverage.enabled=false
