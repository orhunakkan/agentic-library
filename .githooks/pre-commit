#!/bin/sh
set -e

# The secrets scan of what's staged: gitleaks on PATH, or else the pinned image below. With neither, it says it skipped
# and carries on, so a contributor without Docker can still commit. CI doesn't scan for secrets: after this, GitHub's
# own secret scanning and push protection are the checks.
# The staged diff goes to gitleaks on stdin, so it works the same in a linked worktree, whose .git is elsewhere.
GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f # v8.30.1
repo=$(git rev-parse --show-toplevel)
if command -v gitleaks >/dev/null 2>&1; then
  git diff --cached -U0 --no-color | gitleaks stdin --redact --no-banner --config "$repo/.gitleaks.toml"
elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  git diff --cached -U0 --no-color |
    docker run -i --rm -v "$repo/.gitleaks.toml:/config.toml:ro" "$GITLEAKS_IMAGE" \
      stdin --redact --no-banner --config /config.toml
else
  echo "pre-commit: secrets scan skipped (no gitleaks on PATH and no Docker); only GitHub's push protection scans this commit" >&2
fi

pnpm exec biome check --staged --no-errors-on-unmatched
pnpm typecheck
pnpm exec vitest run tests/repo/ --config tests/vitest.config.ts --coverage.enabled=false --reporter=default

# The unit tests related to the staged source files, so a commit that breaks a changed module's test fails here. Only
# the unit config, so it needs neither Postgres nor Chromium; a commit with no staged .ts or .tsx runs nothing. Names
# go NUL-separated from git to xargs, so a file name with a space stays one argument.
git diff --cached --name-only --diff-filter=ACMR -z -- \
  ':(glob)src/**/*.ts' ':(glob)src/**/*.tsx' ':(glob)scripts/**/*.ts' ':(glob)tests/**/*.ts' |
  xargs -0 -r pnpm exec vitest related --run --config tests/vitest.config.ts --coverage.enabled=false --reporter=default --passWithNoTests
